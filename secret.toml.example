[secrets]
# Core LLM (default: DeepSeek-compatible OpenAI API)
LLM_PROVIDER = "deepseek"
LLM_API_KEY = "your_deepseek_api_key"
LLM_BASE_URL = "https://api.deepseek.com/v1"
LLM_MODEL = "deepseek-chat"
# If you use another OpenAI-compatible provider, set:
# LLM_PROVIDER = "openai_compatible"
# LLM_BASE_URL = "https://your-provider-domain/v1"
# LLM_MODEL = "gpt-4o"

# Search / retrieval
ANYSEARCH_API_KEY = "your_anysearch_api_key"
ANYSEARCH_BASE_URL = "https://api.anysearch.ai"
# If search API is unstable in your network, the pipeline keeps running with empty web results.

# Optional APIs
OPENFDA_API_KEY = ""

# Local paths (optional)
DEEPRARE_REPO_PATH = "/absolute/path/to/DeepRare"
RAREBENCH_LOCAL_CSV = "/absolute/path/to/rarebench_local_sample.csv"

[env]
# Runtime parameters
V2_REQUEST_TIMEOUT_S = 30
V2_TOP_K = 5
